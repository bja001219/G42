rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // G42 게임 방. 클라이언트는 Firebase 익명 인증을 완료한 뒤에만 접근한다.
    // 익명 인증은 데모 환경의 최소 경계이며, 운영 서비스에서는 사용자 계정과
    // room.players를 request.auth.uid에 결합하는 멤버 권한 검증이 추가로 필요하다.
    match /rooms/{code} {
      allow read, write: if isSignedIn();
    }

    // 플레이어 통산 전적. profiles/{playerId} 문서 1개 = PlayerStats 1개.
    match /profiles/{id} {
      allow read, write: if isSignedIn();
    }

    // 상대 전적. headtohead/{pairKey} 문서 1개 = HeadToHead 1개.
    match /headtohead/{key} {
      allow read, write: if isSignedIn();
    }
  }
}
